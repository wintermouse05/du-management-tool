# Local ngrok launcher configuration
# Copy this file to .env and fill in your own values.

# Optional launcher flags
SKIP_FRONTEND_BUILD=false
NO_NGROK=false

# Frontend / WebSocket URLs
FRONTEND_URL=http://localhost:8088
WEB_SOCKET_ORIGINS=https://*.ngrok-free.dev,https://*.ngrok-free.app,https://*.ngrok.app,http://localhost:8088,http://localhost:5173,http://localhost:8080

# Mail / forgot-password
NOTIFICATION_EMAIL_ENABLED=false
MAIL_USERNAME=your-email@gmail.com
MAIL_APP_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# ChatOps / Mattermost
CHATOPS_ENABLED=false
CHATOPS_URL=https://mattermost.example.com
CHATOPS_TOKEN=
CHATOPS_ASSISTANT_ID=
CHATOPS_CHANNEL_ID=
CHATOPS_CONFIG_ENCRYPTION_SECRET=replace-with-a-strong-secret
